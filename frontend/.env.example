# Copy to `.env` (same folder) if you need to override defaults.
# Never put secrets here: anything prefixed VITE_ is bundled into public JavaScript.

# Where the Vite dev server forwards /api requests (dev only).
API_PROXY_TARGET=http://localhost:4000

# Optional public origin for a separately deployed API, for example:
# VITE_API_BASE_URL=https://api.example.com
# Leave empty when the production host proxies /api to the API on the same origin.
VITE_API_BASE_URL=
