# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit secrets.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API directly.
# In development the Vite dev server proxies /api, so the browser never needs CORS.
CORS_ORIGINS=http://localhost:5173

# How many reverse proxies sit in front of the API (0 = none). Rate limiting
# uses this to find the real client IP. Set to 1 behind a single load balancer.
TRUST_PROXY=0

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# If `mongodb+srv://` fails with "querySrv ECONNREFUSED", use the standard
# `mongodb://host1,host2,host3/?tls=true&replicaSet=...` form (see README → Troubleshooting).
# Leave empty to run the API without a database during early development;
# the status page will show the database as "not configured". Required in production.
MONGODB_URI=
MONGODB_DB_NAME=similo

# Public address of the website; invitation links point here.
APP_URL=http://localhost:5173

# Internal Python AI service (the ai/ folder).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000
