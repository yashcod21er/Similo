# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit secrets.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API directly.
# In development the Vite dev server proxies /api, so the browser never needs CORS.
CORS_ORIGINS=http://localhost:5173

# How many reverse proxies sit in front of the API (0 = none). Rate limiting
# uses this to find the real client IP. Set to 1 behind a single load balancer.
TRUST_PROXY=0

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# If `mongodb+srv://` fails with "querySrv ECONNREFUSED", use the standard
# `mongodb://host1,host2,host3/?tls=true&replicaSet=...` form (see README → Troubleshooting).
# Leave empty to run the API without a database during early development;
# the status page will show the database as "not configured". Required in production.
MONGODB_URI=
MONGODB_DB_NAME=similo

# Public address of the website; invitation links point here.
APP_URL=http://localhost:5173

# Secret that signs the 15-minute sign-in (JWT access) tokens. Use 32+ random
# characters, keep it private, and never reuse it elsewhere. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production. If empty in development, the API picks a random one at
# each start; browsers then quietly get a new token through their refresh cookie,
# so nobody is signed out (changing the value later behaves the same way).
JWT_SECRET=

# Internal Python AI service (the ai/ folder).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# Phase 6 AI analysis. The API sends this shared secret as a bearer token to the AI
# service's /internal routes; set the SAME value in ai/.env. Use 32+ random characters
# (same command as JWT_SECRET). Required in production. If empty in development, findings
# are still captured but their analysis is marked "unavailable".
AI_SERVICE_TOKEN=
# How long one analysis call to the AI service may take (milliseconds).
AI_ANALYSIS_TIMEOUT_MS=90000
# Open suspect sites in a locked-down headless browser to screenshot them (true/false).
# false = analyse by name and registration date only.
CAPTURE_ENABLED=true
# Leave empty to use Playwright's bundled Chromium (production; install it with
# `npx playwright install chromium`). On a Windows PC you can use the installed Edge
# instead: CAPTURE_BROWSER_CHANNEL=msedge
CAPTURE_BROWSER_CHANNEL=
# The most findings one domain scan queues for analysis (new ones, or not analysed for 7 days).
ANALYSIS_MAX_PER_SCAN=20

# Phase 5 domain monitoring. Install/run Redis (local Redis, Memurai, or Redis Cloud)
# and start the worker with `npm run dev:worker`. Leave REDIS_URL empty to keep the
# API available without monitoring; scan requests will return a clear 503 response.
REDIS_URL=
# fixtures creates clearly labelled reserved .example results for development.
# Use crtsh for Certificate Transparency lookup; RDAP is used only to enrich findings.
# Production refuses fixture mode so sample detections can never look real.
DOMAIN_DISCOVERY_SOURCE=fixtures
DOMAIN_SCAN_INTERVAL_HOURS=24
# A Chromium capture runs per concurrent analysis; keep at 1 on small workers.
# Allowed range: 1-4.
MONITORING_WORKER_CONCURRENCY=1
