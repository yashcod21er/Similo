{
  "name": "similo",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered brand protection and digital risk intelligence platform",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --names frontend,backend,ai,worker --prefix-colors cyan,green,magenta,yellow \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:ai\" \"npm:dev:worker\"",
    "dev:frontend": "npm run dev --workspace @similo/frontend",
    "dev:backend": "npm run dev --workspace @similo/backend",
    "dev:ai": "uv run --directory ai uvicorn app.main:app --reload --port 8000",
    "dev:worker": "npm run dev:worker --workspace @similo/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:ai": "uv run --directory ai pytest",
    "lint:ai": "uv run --directory ai ruff check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:ai && npm run lint:ai",
    "seed:demo": "npm run seed:demo --workspace @similo/backend --",
    "auth:reset-password": "npm run auth:reset-password --workspace @similo/backend --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
