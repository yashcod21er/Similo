# Copy to `.env` in this folder ON THE SERVER and fill in. Never commit `.env`.

# The address people will open, without https://  (for example similo-yash.duckdns.org).
# It must already point at the server's public IP address.
SITE_DOMAIN=

# MongoDB Atlas connection string (the same one as backend/.env on your PC).
# Add the server's public IP in Atlas -> Network Access first.
MONGODB_URI=
MONGODB_DB_NAME=similo

# Two different long random values. Make each with:  openssl rand -hex 32
JWT_SECRET=
AI_SERVICE_TOKEN=

# Optional
DOMAIN_SCAN_INTERVAL_HOURS=24
ANALYSIS_MAX_PER_SCAN=20
