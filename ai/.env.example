# Copy to `.env` in this folder (ai/). Never commit real secrets.

# development | test | production  (production hides /docs and /openapi.json and
# refuses to start without a service token of at least 32 characters)
AI_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
AI_LOG_LEVEL=INFO

# Shared secret for /internal/* (the backend sends it as `Authorization: Bearer <token>`;
# it must equal the backend's AI_SERVICE_TOKEN). Leave empty and every /internal/* call
# answers 503. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=

# Where the AI models are cached (about 440 MB once downloaded). Relative to ai/.
AI_MODELS_DIR=.models
# true = load all models when the service starts (slower start, fast first request).
# false = load each model the first time it is needed.
AI_PRELOAD_MODELS=false
# false = never download models; use only what is already in AI_MODELS_DIR.
AI_ALLOW_MODEL_DOWNLOAD=true

# Requests larger than this many bytes are refused with 413 before they are parsed.
AI_MAX_REQUEST_BYTES=16777216
